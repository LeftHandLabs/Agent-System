# GitHub personal access token with repo + project scope
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Repository shown in the dashboard (owner/repo format)
GITHUB_REPO=your-github-username/your-repo

# GitHub ProjectV2 node ID (found in the project URL or via GraphQL)
GITHUB_PROJECT_ID=PVT_xxxxxxxxxxxxxxxxxxxx

# GitHub project number (the integer shown in the project URL)
GITHUB_PROJECT_NUMBER=1

# Absolute path where the repo will be cloned on this machine
REPO_LOCAL_PATH=/opt/agent-system/workspace

# Anthropic API key — required by claude-agent-sdk for all agent calls.
# Alternatively set ANTHROPIC_AUTH_TOKEN if using Claude Code OAuth login.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
