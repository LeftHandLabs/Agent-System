# GitHub personal access token with repo + project scope
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key — required by claude-agent-sdk for all agent calls.
# Alternatively set ANTHROPIC_AUTH_TOKEN if using Claude Code OAuth login.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
